* {
    bg:       #1a1b26;
    bg-alt:   #16161e;
    bg-sel:   #292e42;
    fg:       #c0caf5;
    fg-dim:   #565f89;
    accent:   #7aa2f7;
    urgent:   #f7768e;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 16";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @accent;
    border-radius:    8px;
    width:            700px;
    padding:          0;
}

mainbox {
    padding: 0;
}

inputbar {
    background-color: @bg-alt;
    padding:          16px 20px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    str:        "launch";
}

entry {
    placeholder:       "search the system...";
    placeholder-color: @fg-dim;
}

listview {
    background-color: @bg;
    padding:          8px;
    lines:            8;
    scrollbar:        false;
}

element {
    padding:       12px 16px;
    border-radius: 6px;
    spacing:       10px;
}

element selected {
    background-color: @bg-sel;
    text-color:       @accent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    size: 0;
}
